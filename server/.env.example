# ===== საქართველოს ბანკი (BOG) =====
# მიიღე Business Online / iPay merchant ანგარიშიდან
BOG_CLIENT_ID=your_client_id_here
BOG_CLIENT_SECRET=your_client_secret_here

# true = დემო (ფული არ იხდება), false = ნამდვილი BOG გადახდა
BOG_DEMO_MODE=true

# შენი საიტის მისამართი (HTTPS აუცილებელია production-ზე)
PUBLIC_URL=http://localhost:3000

# სერვერის პორტი
PORT=3000
